# TMDB API Key for server-side scraping
# Get your own key from: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Web port (optional, defaults to 3000)
WEB_PORT=3000

# App settings file path (optional, for Docker/persistent storage)
# APP_SETTINGS_PATH=/path/to/settings.json

# Default manifest URL (optional)
# DEFAULT_MANIFEST_URL=https://raw.githubusercontent.com/yoruix/nuvio-providers/refs/heads/main/manifest.json
